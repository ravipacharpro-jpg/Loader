<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_apple_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="44dp"
        android:paddingRight="24dp"
        android:paddingBottom="32dp">

        <!-- Hero Apple Identity Header -->
        <LinearLayout
            android:id="@+id/heroHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_apple_cube" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_apple_pill_info"
                android:paddingLeft="14dp"
                android:paddingTop="5dp"
                android:paddingRight="14dp"
                android:paddingBottom="5dp"
                android:text="VIRTUAL ENGINE • ANDROID 10–16"
                android:textColor="#64D2FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="Featurestic Box"
                android:textColor="#F5F5F7"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Sign in with your PHP panel license key to unlock the virtual container."
                android:textColor="#8E8E93"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Frosted Glass Login Card -->
        <LinearLayout
            android:id="@+id/loginGlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_apple_glass_card"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="LICENSE KEY"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Key Input Box with Inline Paste Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_apple_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="10dp">

                <EditText
                    android:id="@+id/etLicenseKey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Enter or paste license key..."
                    android:imeOptions="actionDone"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:singleLine="true"
                    android:textColor="#F5F5F7"
                    android:textColorHint="#565E6D"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnPasteKey"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_apple_segment_unselected"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="Paste"
                    android:textColor="#64D2FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Status Pill Banner -->
            <TextView
                android:id="@+id/tvStatusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_apple_pill_info"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingTop="8dp"
                android:paddingRight="14dp"
                android:paddingBottom="8dp"
                android:text="Ready to authenticate"
                android:textColor="#64D2FF"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Primary Apple Blue Sign-In Button -->
            <LinearLayout
                android:id="@+id/btnSignInContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_apple_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressSignIn"
                     style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="10dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSignInLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Continue to Virtual Box"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- HWID & Encryption Footnote -->
            <TextView
                android:id="@+id/tvHwidBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:text="HWID • DETECTING"
                android:textColor="#636366"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Bottom Support & Get Key Pill -->
        <LinearLayout
            android:id="@+id/footerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnGetKeySupport"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_apple_segment_unselected"
                android:gravity="center"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="Need a License Key? Contact Support →"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
