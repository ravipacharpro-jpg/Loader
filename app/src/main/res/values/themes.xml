<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/ios_grouped_bg</item>
        <item name="android:colorBackground">@color/ios_grouped_bg</item>
        <item name="android:statusBarColor">@color/ios_grouped_bg</item>
        <item name="android:navigationBarColor">@color/ios_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorAccent">@color/ios_blue</item>
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryDark">@color/ios_grouped_bg</item>
        <item name="android:textColorPrimary">@color/ios_label</item>
        <item name="android:textColorSecondary">@color/ios_label_secondary</item>
        <item name="android:textColorHint">@color/ios_label_tertiary</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/splash_top</item>
        <item name="android:navigationBarColor">@color/splash_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="IosTitle">
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="IosSubtitle">
        <item name="android:textColor">@color/ios_label_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="IosLabel">
        <item name="android:textColor">@color/ios_label_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="IosButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
